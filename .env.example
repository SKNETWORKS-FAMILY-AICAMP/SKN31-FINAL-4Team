# ══════════════════════════════════════════════════════════════
#  FEEDiT 환경변수 견본
# ══════════════════════════════════════════════════════════════
#
#   cp .env.example .env      하고 값을 채웁니다.
#   .env 는 .gitignore 에 있습니다. ★ 절대 커밋하지 마세요.
#   이 파일(.env.example)에는 **실제 키를 적지 않습니다.**
#
#   설정이 맞는지 한 번에 보려면:
#       python3 ChatBot/tools_env_check.py
#
# ──────────────────────────────────────────────────────────────
#  1. Django
# ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-바꾸세요1
DJANGO_DEBUG=True

# ──────────────────────────────────────────────────────────────
#  2. DB — 접근 가능한 RDS 주소 또는 별도로 준비한 SSM 터널
#     아래 5433 은 로컬 터널 예시입니다. 연결 방식에 맞게 변경하세요.
# ──────────────────────────────────────────────────────────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

RDS_HOST=
RDS_PORT=5432

# ──────────────────────────────────────────────────────────────
#  3. AWS — SSM 굴과 S3
#     ★ 개인 IAM 키를 쓰세요. 공용 키를 돌려쓰면 누가 무엇을 했는지
#       추적이 안 되고, 한 사람이 유출되면 전원을 회수해야 합니다.
# ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_OUTPUT=json
AWS_REGION=ap-northeast-2
EC2_INSTANCE_ID=
AWS_STORAGE_BUCKET_NAME=

# ──────────────────────────────────────────────────────────────
#  4. Celery / Redis
# ──────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ──────────────────────────────────────────────────────────────
#  5. 수집 API 키
# ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── 검색량 수집 (backend/collection/search_volume) ──────────────
#  ★ 2026-09-21 추가. 네이버 검색광고 · 데이터랩 · Google Ads 키.
#  ⚠️ 아래 GOOGLE_ADS_* 는 '광고 API' 전용이다.
#     구글 "로그인"용 GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (이 파일 아래쪽)과
#     절대 섞지 말 것 — 덮어쓰면 소셜 로그인이 죽는다.
#  ※ Google Trends(pytrends) 는 키가 필요 없다.
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
FEEDIT_TRENDS_DELAY=5          # pytrends 요청 간 대기(초). 429 나면 늘린다
FEEDIT_TRENDS_REGION=1         # G5 시·도별 관심도. 0 이면 끔
FEEDIT_TRENDS_TRENDING=0       # G6 실시간 급상승 — 2026-09-21 스모크 테스트에서 구글이 404.
                               #   pytrends 쪽 엔드포인트가 죽었다. 되살아나면 1 로.
FEEDIT_TRENDS_REGION_LIMIT=50  # G5 지역별을 받을 상위 용어 수(용어당 페이로드 1회라 비쌈)
FEEDIT_PLATFORM_WINDOW_DAYS=90 # 플랫폼별 온도 카드가 되돌아보는 일수

# ── 경험치 (backend/apps/api/xp_service.py) ─────────────────────
#   모든 일반 계정이 0 XP 에서 시작하는 날(한국 시간). 이 날 전의 기록은 세지 않는다.
#   비워 두면 2026-09-25. 배포가 늦어지면 배포일로 적는다.
FEEDIT_XP_START=2026-09-25

# ══════════════════════════════════════════════════════════════
#  6. 챗봇 (ChatBot/)
# ══════════════════════════════════════════════════════════════
#
#  ── LLM ──────────────────────────────────────────────────────
#  ★ 각자 자기 키를 발급받아 넣습니다 (platform.openai.com → API keys).
#    한 사람 키를 다 같이 쓰면 한도가 한 번에 소진되고,
#    누가 얼마나 썼는지 볼 수 없습니다.
# 챗봇 전용
OPENAI_API_KEY=sk-여기에-본인-키
# 리뷰·댓글 분석 전용 (2026-09-20 분리 — 챗봇 키로 대신하지 않는다)
FEEDIT_TEXT_OPENAI_API_KEY=sk-여기에-분석용-키

#  모델. 팀 표준은 gpt-5.6-luna 입니다. 바꿀 일이 있으면 팀에 알리고 바꾸세요 —
#  사람마다 다른 모델을 쓰면 "왜 답이 다르지" 를 영영 못 쫓습니다.
FEEDIT_LLM_MODEL=gpt-5.6-luna

# 역할별 모델 (ChatBot/app/llm.py ROLES)
#   Terra — 판단: 도구 선택·살말 판단(오케스트레이터) · 사진 · 사전 밖 지식 설명
#   Luna  — 닫힌 출력: 의도 분류 · 앞 턴 이어받기 · 다듬기 · 링크/기사 추출 · 숫자 검증 · 마무리
#   Sol   — 막혔을 때만: Terra/Luna 호출이 실패하거나 결과가 깨지면 남은 시간 안에서 한 번 더
FEEDIT_LLM_MODEL_LARGE=gpt-5.6-sol
FEEDIT_LLM_MODEL_MID=gpt-5.6-terra
FEEDIT_LLM_MODEL_SMALL=gpt-5.6-luna
#   0 이면 Sol 재시도를 끈다 (기본 1)
FEEDIT_LLM_ESCALATE=1

#  답변 하나의 시간 상한(초). 답이 빨리 끝나면 그만큼만 쓴다 — 모델이 멈췄을 때 무한 대기를 막는 용도.
#  비워 두면 기본 45초, 링크 질문은 +15초. 값을 줄이면 "조회를 끝까지 하지 못했다" 가 늘어난다.
#  버셀 api/v1/[name].js 의 maxDuration(120)보다 작게 둔다.
# FEEDIT_CHAT_TIME_BUDGET=45
# FEEDIT_CHAT_LINK_EXTRA=15

#  추론 강도: none · low · medium · high · xhigh · max
#  low 로 충분합니다. 챗봇은 숫자를 만들지 않고 문장만 다듬기 때문입니다.
FEEDIT_LLM_EFFORT=low

#  1 로 두면 LLM 을 아예 안 부릅니다 — 규칙만으로 돕니다.
#  키가 없는 팀원도 화면을 볼 수 있게 하려면 이걸 켜세요.
FEEDIT_LLM_DISABLED=0

# 텍스트 지표 파이프라인 (YouTube 댓글 + 커머스 리뷰)
FEEDIT_TEXT_LLM_MODEL=gpt-6-luna
FEEDIT_TEXT_LLM_EFFORT=low
FEEDIT_TEXT_LLM_TIMEOUT=90
FEEDIT_TEXT_LLM_MAX_OUTPUT_TOKENS=12000
FEEDIT_TEXT_BATCH_SIZE=24
# 0이면 그날 대기 문서를 모두 처리합니다. 비용 상한이 필요할 때만 건수를 넣으세요.
FEEDIT_TEXT_DAILY_ANALYSIS_LIMIT=0
FEEDIT_YOUTUBE_DAILY_CHANNEL_LIMIT=50
FEEDIT_YOUTUBE_DAILY_VIDEOS_PER_CHANNEL=10
FEEDIT_YOUTUBE_DAILY_VIDEO_LIMIT=100
FEEDIT_YOUTUBE_COMMENT_LIMIT=100
FEEDIT_YOUTUBE_COMMENT_LOOKBACK_DAYS=180

#  사내 게이트웨이를 쓸 때만. 보통은 비워 둡니다.
# OPENAI_BASE_URL=https://api.openai.com/v1

#  ── 챗봇 데이터 소스 ─────────────────────────────────────────
#  운영은 DB 팀이 적재하는 AWS RDS를 단일 원본으로 사용합니다.
#  DB_HOST·DB_NAME·DB_USER·DB_PASSWORD는 위 2번 값을 그대로 씁니다.
FEEDIT_DATA_BACKEND=rds

#  질문 문장 추출 코드는 ChatBot/vendor/question_extract.py 에 들어 있어 설정할 필요가 없습니다.
#  (다른 곳의 사본을 쓰고 싶을 때만) FEEDIT_EXTRACTOR_DIR=/절대/경로

#  로컬 회귀 테스트에서만 아래처럼 명시하면 SQLite 어댑터를 쓸 수 있습니다.
# FEEDIT_DATA_BACKEND=sqlite
#  Lexicon·어휘 사전은 ChatBot/vendor/ 에 있고, 지표 DB 만 따로 가리키면 됩니다.
# FEEDIT_CHAT_DB=/절대/경로/feedit.db   (또는 ChatBot/vendor/data/feedit.db 에 두기)

#  지표 버전. 크롤러가 계산할 때 쓴 값과 같아야 합니다.
FEEDIT_METRIC_VERSION=feedit-unified-text-v1

#  ── 챗봇 서버 · 요금제 ──────────────────────────────────────
#  공개 베타 기본값. 1이면 서버가 모든 챗봇 기능을 BUSINESS 플랜과 동일하게 연다.
#  (플랜만 연다. FEEDIT_CHAT_TOKEN 이 있으면 베타 중에도 토큰은 검사한다.)
#  베타가 끝나 인증·플랜 제한을 복구할 때만 0으로 바꾼다.
#
#  ★ 2026-10-03 — Django(요금제 · backend/apps/api/plan_policy.py)도 **같은 변수**를 본다.
#    0 으로 바꾸고 API · 챗봇 컨테이너를 다시 띄우면 그때부터
#      · 요금제 표(프리 · 프로 · 비즈니스)대로 막는다 — AI 챗 하루 20회, EDIT 잠금, 내보내기 잠금
#      · 요금제 화면에서 신청을 받고, 운영 계정의 '요금제 신청 심사' 에서 승인 · 반려한다
#      · 알파 계정 발급 · 알파 배너가 멈춘다(알파 계정은 프리로 본다)
#    변수가 없으면 1(베타)로 본다 — 지금 운영 서버의 .env 는 손대지 않아도 된다.
FEEDIT_PUBLIC_BETA=1

#  요금제 확인증 서명 키 — Django 가 서명하고 챗봇이 검사한다(요금제가 '프로' 라는 증명).
#  비워 두면 FEEDIT_CHAT_TOKEN 을 대신 쓴다. 둘 다 비면 베타 이후 챗봇이 모든 사용자를 FREE 로 본다.
#  베타 동안에는 쓰이지 않는다.
#    만들기:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# FEEDIT_PLAN_SECRET=

#  데이터 API 연동(비즈니스 요금제 · backend/apps/api/data_api.py) 한도 — 베타 동안은 쓰이지 않는다.
#  계정당 하루 요청 수 · 키 하나당 분당 요청 수. 비워 두면 10000 · 60.
# FEEDIT_DATA_API_PER_DAY=10000
# FEEDIT_DATA_API_PER_MIN=60

#  ★ 인증이 없습니다. 기본값(127.0.0.1)을 그대로 두세요.
#    도커로 띄울 때만 compose 가 0.0.0.0 을 넣습니다
#    (그때도 포트는 호스트의 127.0.0.1 에만 묶습니다).
FEEDIT_CHAT_HOST=127.0.0.1
FEEDIT_CHAT_PORT=8770

#  프론트 dev 서버 주소가 다르면 쉼표로 이어 적습니다.
# FEEDIT_CHAT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#  ── 밖에 열 때의 최소 방어 ────────────────────────────────
#  ★ 공개 주소로 운영하는 서버에는 반드시 넣으세요(공개 베타 중에도 검사합니다).
#    버셀 CHAT_BACKEND_TOKEN 과 같은 값이어야 합니다. 버셀 함수만 이 값을 붙여
#    보내며 브라우저에는 노출되지 않습니다. 로컬에서는 vite 개발 프록시가
#    이 값을 읽어 붙이므로 따로 할 일이 없습니다.
#
#    만들기:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
#    로컬 개발만 할 거면 비워 두세요 — 비어 있으면 검사하지 않습니다.
FEEDIT_CHAT_TOKEN=

#  IP 당 분당 질문 수. 사람은 이만큼 못 묻습니다.
FEEDIT_CHAT_RATE_PER_MIN=20

# ══════════════════════════════════════════════════════════════
#  읽기 전용 API (backend/apps/api) — 2026-09-09 추가
# ══════════════════════════════════════════════════════════════
#  ★ SSM 굴 없이 운영하려면 이 Django 를 RDS 가 보이는 EC2 에 올리고
#    nginx 로 /api/ 를 엽니다. 그러면 주소를 아는 사람은 누구나
#    사전(브랜드 2,775개)과 상품을 통째로 긁을 수 있습니다.
#    로그인이 아직 없으므로 챗봇과 같은 방식 — 공유 토큰 하나로 막습니다.
#
#      브라우저 ─▶ 버셀 함수 ─(X-FEEDiT-Token)─▶ 이 Django ─▶ RDS
#
#    값은 버셀 환경변수 BACKEND_API_TOKEN 과 **같아야** 합니다.
#    버셀 함수만 이걸 붙여 보냅니다(브라우저는 모릅니다).
#
#    만들기:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
#    로컬 개발만 할 거면 비워 두세요 — 비어 있으면 검사하지 않습니다.
#    (비어 있으면 서버가 뜰 때 경고를 한 줄 남깁니다.)
FEEDIT_API_TOKEN=

#  ── EC2 에 올릴 때의 DB 주소 ──────────────────────────────
#  굴(127.0.0.1:5433) 이 아니라 RDS 를 직접 봅니다.
#  같은 VPC 안이라 보안 그룹만 열려 있으면 닿습니다 —
#  SSM 굴이 이 EC2 를 발판으로 삼고 있었다는 것이 그 증거입니다.
#    DB_HOST=<RDS 엔드포인트 — 팀 비공개 채널에서 확인>
#    DB_PORT=5432

# ══════════════════════════════════════════════════════════════
#  Google 로그인 (backend/apps/api/google_auth.py) — 2026-09-17 추가
# ══════════════════════════════════════════════════════════════
#  Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
#    애플리케이션 유형: 웹 애플리케이션
#    승인된 JavaScript 원본: 버셀 배포 주소, http://localhost:5173
#    (팝업 방식이라 승인된 리디렉션 URI 는 필요 없습니다)
#
#  CLIENT_ID 는 공개 값이라 /api/auth/me 로 프론트에 내려갑니다.
#  CLIENT_SECRET 은 이 서버 .env 에만 둡니다. 버셀·프론트에 넣지 마세요.
#  둘 중 하나라도 비면 Google 버튼은 "설정되지 않았습니다"라고 안내합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════
#  카카오 로그인 (backend/apps/api/kakao_auth.py)
# ══════════════════════════════════════════════════════════════
#  카카오 디벨로퍼스(developers.kakao.com) → 내 애플리케이션 → 애플리케이션 추가
#    · 앱 키 → REST API 키 를 KAKAO_REST_API_KEY 에
#    · 카카오 로그인 → 활성화 설정 ON
#    · 카카오 로그인 → Redirect URI 에 "사이트 첫 화면 주소"를 등록 (끝의 / 까지 똑같이)
#        https://fee-di-t-frontend.vercel.app/
#        http://localhost:5173/
#    · 플랫폼 → Web 사이트 도메인에 위 두 주소의 도메인 등록
#    · 동의항목 → 닉네임 켜기. 이메일은 비즈 앱(개인 개발자도 전환 가능)에서만 켤 수 있고,
#      없으면 이메일 없이 가입된다.
#  보안 → Client Secret 을 '사용함'으로 켰다면 그 값을 KAKAO_CLIENT_SECRET 에 넣습니다.
#  KAKAO_REDIRECT_URIS 를 채우면 그 주소들로만 돌아오게 막습니다(쉼표 구분, 비우면 제한 없음).
#  KAKAO_REST_API_KEY 가 비면 카카오 버튼은 "설정되지 않았습니다"라고 안내합니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URIS=https://fee-di-t-frontend.vercel.app/,http://localhost:5173/

# ══════════════════════════════════════════════════════════════
#  메일 발송 — 회원가입 이메일 인증번호 (backend/apps/api/email_verify.py)
# ══════════════════════════════════════════════════════════════
#  EMAIL_HOST 가 비어 있으면 DJANGO_DEBUG=true 일 때만 runserver 콘솔에 메일 내용을 찍고,
#  운영에서는 "이메일 발송이 설정되지 않았습니다"로 가입이 막힙니다.
#  Gmail 예시: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 발급 (하루 발송량 제한 있음)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

#  운영 알림 메일 — 수집 실패(소스마다 하루 한 번) · 장기 미갱신(매일 09:20)
#  (backend/apps/core/services/ops_alerts.py). 위 EMAIL_HOST 가 있어야 나간다.
#  쉼표로 여러 주소. 비우면 운영 계정(is_staff)에 적힌 이메일로 보낸다.
